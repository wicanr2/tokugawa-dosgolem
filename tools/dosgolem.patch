+func (c *CPU) adc32(left, right uint32) uint32 {
+	carry := c.EFlags & CF
+	result := c.add32(left, right+carry)
+	c.EFlags &^= CF | AF | OF
+	if uint64(left)+uint64(right)+uint64(carry) > 0xffffffff {
+		c.EFlags |= CF
+	}
+	if (left^right^result)&0x10 != 0 {
+		c.EFlags |= AF
+	}
+	if (^(left^right)&(left^result))&0x80000000 != 0 {
+		c.EFlags |= OF
+	}
+	return result
+}
