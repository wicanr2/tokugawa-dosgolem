+func (c *CPU) adc16(left, right uint16) uint16 {
+	carry := c.EFlags & CF
+	sum := uint32(left) + uint32(right) + carry
+	result := uint16(sum)
+	c.setLogicFlags16(result)
+	if sum > 0xffff {
+		c.EFlags |= CF
+	}
+	if (left^right^result)&0x10 != 0 {
+		c.EFlags |= AF
+	}
+	if (^(left ^ right) & (left ^ result) & 0x8000) != 0 {
+		c.EFlags |= OF
+	}
+	return result
+}
